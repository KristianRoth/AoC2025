# Advent of Code 2025, day 4 part 1 (Printing Department)
#
# THE PUZZLE
# The input is a grid; each cell is empty (.) or holds a roll of paper (@). A forklift can reach a roll
# when fewer than four of the eight cells around it hold a roll. The answer is the number of such rolls.
#
# THE IDEA
# In memory an empty cell is the word 1 and a roll is the word 16. Then nothing has to be counted: the
# program adds up the nine words of the 3 x 3 block around a roll and looks at the sum.
#     the roll itself                      16
#     each neighbouring roll               16
#     each empty neighbour                  1
#     each neighbour outside the grid       0
# With three neighbouring rolls the sum is at most 16 + 3 * 16 + 5 = 69; with four it is at least
# 16 + 4 * 16 = 80. So:   the roll can be reached   <=>   the sum is below 80.
#
# NO EDGES TO TEST
# Each row is followed by one word 0. The rows lie one after the other, so the cell "left of" a row's
# first cell is the 0 that ends the row above, and the cell right of its last cell is its own 0. Above
# the first row and below the last the memory holds 0 as well. A 0 adds nothing to a sum, so the cells
# on the border need no special case. The distance from a cell to the one below it is STRIDE = width + 1.
#
#     address        P - STRIDE - 1   P - STRIDE   P - STRIDE + 1      the row above
#                    P - 1            P            P + 1               the roll's own row
#                    P + STRIDE - 1   P + STRIDE   P + STRIDE + 1      the row below
#
# THE WHOLE PROGRAM IN PSEUDO CODE
#     STRIDE = (address of the first 0 in the grid) - (address of the grid) + 1
#     COUNT = 0
#     P = address of the grid
#     loop:
#         if memory[P] == 0:                    # the end of a row
#             P = P + 1
#             if memory[P] == 0: break          # an empty row: the end of the grid
#             continue
#         if memory[P] == 16:                   # a roll
#             SUM = 0
#             ROW = P - STRIDE - 1; ADD_THREE   # SUM = SUM + memory[ROW] + memory[ROW+1] + memory[ROW+2]
#             ROW = P - 1;          ADD_THREE
#             ROW = P + STRIDE - 1; ADD_THREE
#             if SUM < 80: COUNT = COUNT + 1
#         P = P + 1
#     write COUNT as five decimal digits
#     stop
#
# THE RESULT, when the CPU stops on the Breakpoint at END
#   0x0100         the count as one 16-bit word
#   0x0110-0x0114  the count as five decimal digits, one per word, most significant first
#
# THE INPUT (rule 1 of RULES.md), at 0x2000
# One word per cell, row after row: 1 for an empty cell, 16 for a roll. A word 0 ends each row, and a
# second 0 after the last row ends the grid. Built-in limits: the memory just before 0x2000 must hold
# zeros for at least one row's length (it does: 0x1F00-0x1FFF is unused, so rows of up to 254 cells);
# the count must stay below 65,536.
#
# ONE WORD IS ENOUGH
# Every value here fits in 16 bits, so each variable is one memory word. The idioms used everywhere
# (v is a variable's address, below 0x1000):
#     getA v                   A = the word at v   (lia v; load rgA rgA: lia puts the address in A, load replaces it)
#     getB v                   B = the word at v
#     putA v                   the word at v = A   (this uses up B)
#     if_eq L / if_neq L       compares A with B as they are now
#     sub; if_nega L           after A - B: taken when A < B
# P and ROW are pointers: variables that hold an address in the grid. Reading the cell a pointer points
# at is one more load:  getAat P   (first A = P, then A = the word at P).
# What each instruction does exactly is in findings/cpu-instructions.md.
#
# MEMORY MAP
#   0x0100-0x0128  variables            0x1E00-  POWERS: 10000, 1000, 100, 10, 1, 0
#   0x1000-        the program          0x1F00-0x1FFF  must stay 0 (the "row above the first row")
#   0x1800-        the subroutine       0x2000-  the grid (138 rows of 138 end at 0x6AEE)
#   0xFF00         where the CPU starts

# ---- The CPU's instructions as symbols (the same table as in day 1) ----
symbol nop 0b0000_0000_0000_0000
symbol ld  0b0010_0000_0000_0000
symbol lia 0b0011_0000_0000_0000
symbol lib 0b0100_0000_0000_0000
symbol sto 0b0101_0000_0000_0000

macro  load  { ld  | a? | (b? >> 6) }
macro  store { sto | a? | (b? >> 6) }

# ---- Macros for the common operations (the README explains them; a macro cannot use load or store,
#      so the bodies spell those out). v: a variable, p: a variable holding an address, L: a label ----
macro getA     { lia a?; ld | rgA | (rgA >> 6) }                                                  # getA v: A = v
macro getB     { lib a?; ld | rgB | (rgB >> 6) }                                                  # getB v: B = v
macro putA     { lib a?; sto | rgA | (rgB >> 6) }                                                 # putA v: v = A (B is used up)
macro getAat   { lia a?; ld | rgA | (rgA >> 6); ld | rgA | (rgA >> 6) }                           # getAat p: A = the word p points at
macro putAat   { lib a?; ld | rgB | (rgB >> 6); sto | rgA | (rgB >> 6) }                          # putAat p: the word p points at = A (B is used up)
macro inc      { lia a?; ld | rgA | (rgA >> 6); lib 1; sum; lib a?; sto | rgA | (rgB >> 6) }      # inc v: v = v + 1 (A and B are used up)
macro goto     { jmp; a? }                                                                        # goto L: jump to L
macro if_eq    { jmp eq; a? }                                                                     # if_eq L: jump to L when A == B
macro do       { call; a? }                                                                       # do L: call the subroutine L
macro if_carry { jmp carry; a? }                                                                  # if_carry L: jump to L when the last sum or sub set the carry
macro if_nega  { jmp nega; a? }                                                                   # if_nega L: jump to L when the last sub went below 0

symbol sum    0b0110_0100_0000_0000
symbol sum_32 0b0110_1100_0000_0000
symbol sub    0b0110_0010_0000_0000
symbol sub_32 0b0110_1010_0000_0000
symbol shf    0b0110_0001_0000_0000
symbol shf_32 0b0110_1001_0000_0000
symbol and    0b0110_0000_1000_0000
symbol and_32 0b0110_1000_1000_0000
symbol or     0b0110_0000_0100_0000
symbol or_32  0b0110_1000_0100_0000
symbol xor    0b0110_0000_0010_0000
symbol xor_32 0b0110_1000_0010_0000
symbol neg    0b0110_0000_0001_0000
symbol neg_32 0b0110_1000_0001_0000

symbol psh 0b1010_0000_0000_0000
symbol pop 0b1011_0000_0000_0000

symbol jmp  0b1100_0000_0000_0000
symbol call 0b1110_0000_0000_0000
symbol ret  0b1111_0000_0000_0000

symbol rgAH 0b1000_0000_0000
symbol rgA  0b0100_0000_0000
symbol rgBH 0b0010_0000_0000
symbol rgB  0b0001_0000_0000
symbol rgSP 0b0000_1000_0000
symbol rgSB 0b0000_0100_0000
symbol non  0

symbol zero  0b1000_0000_0000
symbol carry 0b0100_0000_0000
symbol nega  0b0010_0000_0000
symbol eq    0b0001_0000_0000
symbol neq   0b0000_1000_0000

# ---- Variables (all below 0x1000, so lia/lib can address them) ----
# The result
pointer COUNT 0x0100 0
# P: the address of the cell being looked at. STRIDE: the distance to the cell below.
pointer P 0x0120 0x2000
pointer STRIDE 0x0121 0
# For one roll: ROW is the address of the left cell of a row of three, SUM the sum of the 3 x 3 block
pointer ROW 0x0122 0
pointer SUM 0x0123 0
# For the decimal digits: what is left of the count, the current power of ten, how often it fitted
pointer REST 0x0124 0
pointer POWER 0x0125 0
pointer DIGIT_VALUE 0x0126 0
# Pointers: DIGIT the next digit to write, POW the next power of ten
pointer DIGIT 0x0127 0x0110
pointer POW 0x0128 0x1E00
# A constant that does not fit an instruction's place for a number
pointer GRID 0x0129 0x2000

# ---- The CPU starts at 0xFF00 ----
origin 0xFF00
goto MAIN

origin 0x1000
@ MAIN
# ==== find the width of the grid ====
#     ROW = GRID
#     while memory[ROW] != 0: ROW = ROW + 1     # ROW is free for this; it walks along the first row
#     STRIDE = ROW - GRID + 1
@ FIND_WIDTH
	getA GRID; putA ROW                                          # ROW = the address of the grid
@ FIND_WIDTH_NEXT
	getAat ROW                                                   # A = memory[ROW]
	lib 0                                                        # B = 0, to compare with
	if_eq WIDTH_FOUND                                            # the 0 that ends the first row
	inc ROW                                                      # ROW = ROW + 1
	goto FIND_WIDTH_NEXT
@ WIDTH_FOUND
	getA ROW; getB GRID; sub                                     # A = ROW - GRID, the width
	lib 1; sum; putA STRIDE                                      # STRIDE = width + 1

# ==== look at the next cell ====
#     if memory[P] == 0: goto END_OF_ROW
#     if memory[P] == 16: goto ROLL
#     P = P + 1                                 # an empty cell
@ NEXT_CELL
	getAat P                                                     # A = memory[P]
	lib 0                                                        # B = 0
	if_eq END_OF_ROW
	lib 16                                                       # B = 16, a roll
	if_eq ROLL
@ STEP_ON
	inc P                                                        # P = P + 1
	goto NEXT_CELL

# ==== a roll: add up its 3 x 3 block ====
#     SUM = 0
#     ROW = P - STRIDE - 1; ADD_THREE           # the row above
#     ROW = P - 1;          ADD_THREE           # its own row (the roll itself is in the sum)
#     ROW = P + STRIDE - 1; ADD_THREE           # the row below
#     if SUM < 80: COUNT = COUNT + 1
@ ROLL
	lia 0; putA SUM                                              # SUM = 0
	getA P; getB STRIDE; sub                                     # A = P - STRIDE
	lib 1; sub; putA ROW                                         # ROW = P - STRIDE - 1
	do ADD_THREE
	getA P; lib 1; sub; putA ROW                                 # ROW = P - 1
	do ADD_THREE
	getA P; getB STRIDE; sum                                     # A = P + STRIDE
	lib 1; sub; putA ROW                                         # ROW = P + STRIDE - 1
	do ADD_THREE
	# fewer than four neighbouring rolls <=> SUM < 80
	getA SUM; lib 80; sub                                        # A - B is negative when SUM < 80
	if_nega REACHABLE
	goto STEP_ON                                                 # four or more neighbours
@ REACHABLE
	inc COUNT                                                    # COUNT = COUNT + 1
	goto STEP_ON

# ==== the end of a row ====
#     P = P + 1                                 # step over the 0
#     if memory[P] == 0: goto ALL_ROWS_DONE     # a second 0: the end of the grid
@ END_OF_ROW
	inc P                                                        # P = P + 1
	load rgA rgA                                                 # A = memory[P]   (A still held P)
	lib 0                                                        # B = 0
	if_eq ALL_ROWS_DONE
	goto NEXT_CELL

# ==== write COUNT as five decimal digits ====
# A digit is how often a power of ten fits into what is left. Without division that is counting:
#     REST = COUNT
#     for POWER in 10000, 1000, 100, 10, 1:
#         DIGIT_VALUE = 0
#         while REST >= POWER: REST = REST - POWER; DIGIT_VALUE = DIGIT_VALUE + 1
#         memory[DIGIT] = DIGIT_VALUE; DIGIT = DIGIT + 1
# After sub, the carry flag is set when A >= B (no borrow).
@ ALL_ROWS_DONE
	getA COUNT; putA REST                                        # REST = COUNT
@ NEXT_POWER
	getAat POW                                                   # A = memory[POW], the next power of ten
	putA POWER                                                   # POWER = A
	lib 0                                                        # B = 0
	if_eq END                                                    # a power of 0 ends the table
	inc POW                                                      # POW = POW + 1
	lia 0; putA DIGIT_VALUE                                      # DIGIT_VALUE = 0
@ FITS_AGAIN
	getA REST; getB POWER                                        # A = REST, B = POWER
	sub                                                          # A = REST - POWER
	if_carry FITS                                                # REST >= POWER: it fits once more
	getA DIGIT_VALUE; putAat DIGIT                                       # memory[DIGIT] = DIGIT_VALUE   (B holds the address in DIGIT)
	inc DIGIT                                                    # DIGIT = DIGIT + 1
	goto NEXT_POWER
@ FITS
	putA REST                                                    # REST = REST - POWER   (A still holds the difference)
	inc DIGIT_VALUE                                                          # DIGIT_VALUE = DIGIT_VALUE + 1
	goto FITS_AGAIN

# The word 0 stops the CPU on its Breakpoint.
@ END
	non

# ---- Subroutine ----
origin 0x1800
# ADD_THREE: add the three cells starting at the address in ROW to SUM.
#     SUM = SUM + memory[ROW] + memory[ROW + 1] + memory[ROW + 2]
# The address is worked out in A, then load rgA rgA replaces it by the cell it points at.
@ ADD_THREE
	getAat ROW                                                   # A = memory[ROW]
	getB SUM; sum; putA SUM                                      # SUM = SUM + A
	getA ROW; lib 1; sum; load rgA rgA                           # A = memory[ROW + 1]
	getB SUM; sum; putA SUM                                      # SUM = SUM + A
	getA ROW; lib 2; sum; load rgA rgA                           # A = memory[ROW + 2]
	getB SUM; sum; putA SUM                                      # SUM = SUM + A
	ret

# ---- Powers of ten for the decimal digits, then 0 ----
origin 0x1E00
10000; 1000; 100; 10; 1; 0

# ---- The grid: 138 rows of 138 cells ----
# One word per cell: 1 = empty, 16 = a roll; a 0 ends each row; one more 0 ends the grid.
origin 0x2000
# row 1: @@@@@@..@@@.@@.@@@@.@@@.@.@@@@@..@...@@@@@@@@.@@.@@@@@.@...@.@@@.@@@.@....@@@..@@@@@@@@.@@..@.@@..@@.@@@@@@.@@@@.@...@@.@.@@.@...@@.@.@@..
16; 16; 16; 16; 16; 16; 1; 1; 16; 16; 16; 1; 16; 16; 1; 16; 16; 16; 16; 1; 16; 16; 16; 1; 16; 1; 16; 16; 16; 16; 16; 1; 1; 16; 1; 1; 1; 16; 16; 16; 16; 16; 16; 16; 16; 1; 16; 16; 1; 16; 16; 16; 16; 16; 1; 16; 1; 1; 1; 16; 1; 16; 16; 16; 1; 16; 16; 16; 1; 16; 1; 1; 1; 1; 16; 16; 16; 1; 1; 16; 16; 16; 16; 16; 16; 16; 16; 1; 16; 16; 1; 1; 16; 1; 16; 16; 1; 1; 16; 16; 1; 16; 16; 16; 16; 16; 16; 1; 16; 16; 16; 16; 1; 16; 1; 1; 1; 16; 16; 1; 16; 1; 16; 16; 1; 16; 1; 1; 1; 16; 16; 1; 16; 1; 16; 16; 1; 1; 0
