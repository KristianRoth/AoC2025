# Advent of Code 2025, day 4 part 2 (Printing Department)
#
# THE PUZZLE
# The input is a grid; each cell is empty (.) or holds a roll of paper (@). A roll can be removed when
# fewer than four of the eight cells around it hold a roll. Removing rolls can make more rolls
# removable. The answer is how many rolls are removed in the end, when no more can be.
#
# THE IDEA
# The order of removing does not matter: taking a roll away never makes another roll harder to reach.
# So the program removes a roll the moment it finds one that can go. What it must not do is forget the
# rolls it has already looked at: a removal can make one of those removable. But only the eight
# neighbours of the removed roll can be affected. So:
#     - P walks over the grid once, cell by cell.
#     - When a roll is removed, its neighbours that P has already passed are put on a to-do stack.
#       (Neighbours that P has not reached yet need no note: P will come to them.)
#     - Before P moves on, every roll on the to-do stack is looked at again, which may remove it and
#       put more rolls on the stack.
# When P reaches the end of the grid and the stack is empty, no roll that is left can be removed.
# For the real input this looks at a roll 21,385 times; sweeping the whole grid again and again until
# nothing changes would take 49 sweeps and 195,394 looks.
#
# IS A ROLL REMOVABLE? (as in part 1)
# In memory an empty cell is the word 1 and a roll is the word 16. The program adds up the nine words
# of the 3 x 3 block around the roll: with three neighbouring rolls the sum is at most 69, with four at
# least 80. So the roll can go when the sum is below 80. A removed roll becomes a 1.
# Each row is followed by one word 0, and the memory above and below the grid is 0, so a cell beyond
# the edge adds nothing and the border needs no special case. STRIDE = width + 1 is the distance from a
# cell to the one below it.
#
# THE WHOLE PROGRAM IN PSEUDO CODE
#     STRIDE = (address of the first 0 in the grid) - (address of the grid) + 1
#     COUNT = 0; TOP = STACK                    # the to-do stack is empty
#     P = address of the grid
#     loop:
#         if memory[P] == 0:                    # the end of a row
#             P = P + 1
#             if memory[P] == 0: break          # an empty row: the end of the grid
#             continue
#         if memory[P] == 16:                   # a roll
#             Q = P
#             repeat:
#                 if memory[Q] == 16 and block_sum(Q) < 80:
#                     memory[Q] = 1; COUNT = COUNT + 1          # remove it
#                     for each of the 8 neighbours N of Q:
#                         if memory[N] == 16 and N < P: push N  # a roll that P has already passed
#                 if TOP == STACK: break        # nothing left to look at again
#                 Q = pop
#         P = P + 1
#     write COUNT as five decimal digits
#     stop
#
# THE RESULT, when the CPU stops on the Breakpoint at END
#   0x0100         the count as one 16-bit word
#   0x0110-0x0114  the count as five decimal digits, one per word, most significant first
# The grid at 0x2000 is changed by the run: every removed roll is a 1 afterwards.
#
# THE INPUT (rule 1 of RULES.md), at 0x2000
# One word per cell, row after row: 1 for an empty cell, 16 for a roll. A word 0 ends each row, and a
# second 0 after the last row ends the grid. Built-in limits: the memory just before 0x2000 must hold
# zeros for at least one row's length (0x1F00-0x1FFF is unused, so rows of up to 254 cells); the count
# must stay below 65,536; the to-do stack has room for 3,584 addresses (the real input needs 103).
#
# ONE WORD IS ENOUGH
# Every value here fits in 16 bits, so each variable is one memory word. The idioms used everywhere
# (v is a variable's address, below 0x1000):
#     getA v                   A = the word at v   (lia v; load rgA rgA: lia puts the address in A, load replaces it)
#     getB v                   B = the word at v
#     putA v                   the word at v = A   (this uses up B)
#     if_eq L / if_neq L       compares A with B as they are now
#     sub; if_nega L           after A - B: taken when A < B
# P, Q, N, ROW and TOP are pointers: variables that hold an address. Reading the cell a pointer points
# at is one more load:  getAat P   (first A = P, then A = the word at P).
# What each instruction does exactly is in findings/cpu-instructions.md.
#
# MEMORY MAP
#   0x0100-0x012C  variables            0x1800-  the subroutines
#   0x0200-0x0FFF  the to-do stack      0x1E00-  POWERS: 10000, 1000, 100, 10, 1, 0
#   0x1000-        the program          0x1F00-0x1FFF  must stay 0 (the "row above the first row")
#   0xFF00         where the CPU starts 0x2000-  the grid (138 rows of 138 end at 0x6AEE)

# ---- The CPU's instructions as symbols (day 1's table without its _32 names, which the CPU ignores) ----
symbol nop 0b0000_0000_0000_0000            # the word 0: stops the CPU (the same word as non)
symbol ld  0b0010_0000_0000_0000            # load a register from memory (used through the load macro)
symbol lia 0b0011_0000_0000_0000            # lia n: A = n (0 to 4095), upper half 0
symbol lib 0b0100_0000_0000_0000            # lib n: B = n (0 to 4095), upper half 0
symbol sto 0b0101_0000_0000_0000            # store a register to memory (used through the store macro)

macro  load  { ld  | a? | (b? >> 6) }       # load X Y: X = the word at the address in Y
macro  store { sto | a? | (b? >> 6) }       # store X Y: the word at the address in Y = X

symbol sum    0b0110_0100_0000_0000         # A = A + B (32 bits), sets zero, carry, nega
symbol sub    0b0110_0010_0000_0000         # A = A - B (32 bits), sets zero, carry, nega
symbol shf    0b0110_0001_0000_0000         # shf | k: A = A shifted left by k (0 to 15)
symbol and    0b0110_0000_1000_0000         # A = A and B
symbol or     0b0110_0000_0100_0000         # A = A or B
symbol xor    0b0110_0000_0010_0000         # A = A xor B
symbol neg    0b0110_0000_0001_0000         # A = every bit of A flipped

symbol psh 0b1010_0000_0000_0000            # psh X: push the 16 bits of X
symbol pop 0b1011_0000_0000_0000            # pop X: pop 16 bits into X

symbol jmp  0b1100_0000_0000_0000           # jmp; L: go to L.  jmp c; L: go to L when c holds
symbol call 0b1110_0000_0000_0000           # call; L: run the subroutine at L
symbol ret  0b1111_0000_0000_0000           # return from a subroutine

# The registers, as load, store, psh and pop name them
symbol rgAH 0b1000_0000_0000                # the upper 16 bits of A
symbol rgA  0b0100_0000_0000                # the lower 16 bits of A
symbol rgBH 0b0010_0000_0000                # the upper 16 bits of B
symbol rgB  0b0001_0000_0000                # the lower 16 bits of B
symbol rgSP 0b0000_1000_0000                # the program counter (leave alone)
symbol rgSB 0b0000_0100_0000                # the stack pointer (leave alone)
symbol non  0                               # stops the CPU (Breakpoint): the end of the program

# The conditions of jmp
symbol zero  0b1000_0000_0000               # the last sum or sub gave 0
symbol carry 0b0100_0000_0000               # the last sum carried, or the last sub did not borrow (A >= B)
symbol nega  0b0010_0000_0000               # the last sub went below 0 (A < B)
symbol eq    0b0001_0000_0000               # A == B right now
symbol neq   0b0000_1000_0000               # A != B right now

# ---- Macros for the common operations (explained in the README). A macro cannot use another macro, so
#      load and store are spelled out here. v: a variable, p: a variable holding an address, L: a label ----
macro getA     { lia a?; ld | rgA | (rgA >> 6) }                                              # A = v
macro getB     { lib a?; ld | rgB | (rgB >> 6) }                                              # B = v
macro putA     { lib a?; sto | rgA | (rgB >> 6) }                                             # v = A (uses B)
macro getAat   { lia a?; ld | rgA | (rgA >> 6); ld | rgA | (rgA >> 6) }                       # A = the word p points at
macro putAat   { lib a?; ld | rgB | (rgB >> 6); sto | rgA | (rgB >> 6) }                      # the word p points at = A (uses B)
macro inc      { lia a?; ld | rgA | (rgA >> 6); lib 1; sum; lib a?; sto | rgA | (rgB >> 6) }  # v = v + 1 (uses A and B)
macro goto     { jmp; a? }                                                                    # go to L
macro if_eq    { jmp eq; a? }                                                                 # go to L when A == B
macro if_neq   { jmp neq; a? }                                                                # go to L when A != B
macro do       { call; a? }                                                                   # call the subroutine L
macro if_carry { jmp carry; a? }                                                              # go to L after a sub when A >= B
macro if_nega  { jmp nega; a? }                                                               # go to L after a sub when A < B

# ---- Variables (all below 0x1000, so lia/lib can address them) ----
# The result
pointer COUNT 0x0100 0
# P: the address of the cell the walk has reached. STRIDE: the distance to the cell below.
pointer P 0x0120 0x2000
pointer STRIDE 0x0121 0
# Q: the roll being looked at (P, or one taken from the to-do stack)
pointer Q 0x0122 0
# ROW: the address of the left cell of a row of three. SUM: the sum of a 3 x 3 block. N: a neighbour.
pointer ROW 0x0123 0
pointer SUM 0x0124 0
pointer N 0x0125 0
# TOP: the address where the next entry goes on the to-do stack
pointer TOP 0x0126 0x0200
# For the decimal digits: what is left of the count, the current power of ten, how often it fitted
pointer REST 0x0127 0
pointer POWER 0x0128 0
pointer DIGIT_VALUE 0x0129 0
# Pointers: DIGIT the next digit to write, POW the next power of ten
pointer DIGIT 0x012A 0x0110
pointer POW 0x012B 0x1E00
# A constant that does not fit an instruction's place for a number
pointer GRID 0x012C 0x2000
# The to-do stack. Its address is small enough to be written in an instruction (lib STACK).
pointer STACK 0x0200 0

# ---- The CPU starts at 0xFF00 ----
origin 0xFF00
goto MAIN

origin 0x1000
@ MAIN
# ==== find the width of the grid ====
#     ROW = GRID
#     while memory[ROW] != 0: ROW = ROW + 1     # ROW is free for this; it walks along the first row
#     STRIDE = ROW - GRID + 1
	getA GRID; putA ROW                                          # ROW = the address of the grid
@ FIND_WIDTH_NEXT
	getAat ROW                                                   # A = memory[ROW]
	lib 0                                                        # B = 0, to compare with
	if_eq WIDTH_FOUND                                            # the 0 that ends the first row
	inc ROW                                                      # ROW = ROW + 1
	goto FIND_WIDTH_NEXT
@ WIDTH_FOUND
	getA ROW; getB GRID; sub                                     # A = ROW - GRID, the width
	lib 1; sum; putA STRIDE                                      # STRIDE = width + 1

# ==== the walk: look at the next cell ====
#     if memory[P] == 0: goto END_OF_ROW
#     if memory[P] == 16: Q = P; goto LOOK_AT_Q
#     P = P + 1                                 # an empty cell
@ NEXT_CELL
	getAat P                                                     # A = memory[P]
	lib 0                                                        # B = 0
	if_eq END_OF_ROW
	lib 16                                                       # B = 16, a roll
	if_neq STEP_ON                                               # an empty cell
	getA P; putA Q                                               # Q = P
	goto LOOK_AT_Q
@ STEP_ON
	inc P                                                        # P = P + 1
	goto NEXT_CELL

# ==== is the roll at Q removable? ====
#     SUM = 0
#     ROW = Q - STRIDE - 1; ADD_THREE           # the row above
#     ROW = Q - 1;          ADD_THREE           # its own row (the roll itself is in the sum)
#     ROW = Q + STRIDE - 1; ADD_THREE           # the row below
#     if SUM < 80: goto REMOVE_Q
#     goto NEXT_TODO
@ LOOK_AT_Q
	lia 0; putA SUM                                              # SUM = 0
	getA Q; getB STRIDE; sub                                     # A = Q - STRIDE
	lib 1; sub; putA ROW                                         # ROW = Q - STRIDE - 1
	do ADD_THREE
	getA Q; lib 1; sub; putA ROW                                 # ROW = Q - 1
	do ADD_THREE
	getA Q; getB STRIDE; sum                                     # A = Q + STRIDE
	lib 1; sub; putA ROW                                         # ROW = Q + STRIDE - 1
	do ADD_THREE
	# fewer than four neighbouring rolls <=> SUM < 80
	getA SUM; lib 80; sub                                        # A - B is negative when SUM < 80
	if_nega REMOVE_Q
	goto NEXT_TODO                                               # four or more neighbours: the roll stays

# ==== remove the roll at Q and note the neighbours that must be looked at again ====
#     memory[Q] = 1; COUNT = COUNT + 1
#     ROW = Q - STRIDE - 1; PUSH_THREE          # the three cells above
#     ROW = Q - 1;          PUSH_THREE          # left, Q itself (now empty, so not pushed), right
#     ROW = Q + STRIDE - 1; PUSH_THREE          # the three cells below
@ REMOVE_Q
	lia 1; putAat Q                                              # memory[Q] = 1: the cell is empty now
	inc COUNT                                                    # COUNT = COUNT + 1
	getA Q; getB STRIDE; sub                                     # A = Q - STRIDE
	lib 1; sub; putA ROW                                         # ROW = Q - STRIDE - 1
	do PUSH_THREE
	getA Q; lib 1; sub; putA ROW                                 # ROW = Q - 1
	do PUSH_THREE
	getA Q; getB STRIDE; sum                                     # A = Q + STRIDE
	lib 1; sub; putA ROW                                         # ROW = Q + STRIDE - 1
	do PUSH_THREE

# ==== take the next roll from the to-do stack ====
#     if TOP == STACK: goto STEP_ON             # the stack is empty: the walk goes on
#     TOP = TOP - 1; Q = memory[TOP]
#     if memory[Q] != 16: goto NEXT_TODO        # it was removed in the meantime
#     goto LOOK_AT_Q
@ NEXT_TODO
	getA TOP; lib STACK                                          # A = TOP, B = the address of the stack's first word
	if_eq STEP_ON                                                # nothing left to look at again
	lib 1; sub; putA TOP                                         # TOP = TOP - 1
	load rgA rgA; putA Q                                         # Q = memory[TOP]   (A held TOP)
	load rgA rgA                                                 # A = memory[Q]   (A held Q)
	lib 16                                                       # B = 16
	if_neq NEXT_TODO                                             # no longer a roll
	goto LOOK_AT_Q

# ==== the end of a row ====
#     P = P + 1                                 # step over the 0
#     if memory[P] == 0: goto ALL_ROWS_DONE     # a second 0: the end of the grid
@ END_OF_ROW
	inc P                                                        # P = P + 1
	load rgA rgA                                                 # A = memory[P]   (A still held P)
	lib 0                                                        # B = 0
	if_eq ALL_ROWS_DONE
	goto NEXT_CELL

# ==== write COUNT as five decimal digits ====
# A digit is how often a power of ten fits into what is left. Without division that is counting:
#     REST = COUNT
#     for POWER in 10000, 1000, 100, 10, 1:
#         DIGIT_VALUE = 0
#         while REST >= POWER: REST = REST - POWER; DIGIT_VALUE = DIGIT_VALUE + 1
#         memory[DIGIT] = DIGIT_VALUE; DIGIT = DIGIT + 1
# After sub, the carry flag is set when A >= B (no borrow).
@ ALL_ROWS_DONE
	getA COUNT; putA REST                                        # REST = COUNT
@ NEXT_POWER
	getAat POW                                                   # A = memory[POW], the next power of ten
	putA POWER                                                   # POWER = A
	lib 0                                                        # B = 0
	if_eq END                                                    # a power of 0 ends the table
	inc POW                                                      # POW = POW + 1
	lia 0; putA DIGIT_VALUE                                      # DIGIT_VALUE = 0
@ FITS_AGAIN
	getA REST; getB POWER                                        # A = REST, B = POWER
	sub                                                          # A = REST - POWER
	if_carry FITS                                                # REST >= POWER: it fits once more
	getA DIGIT_VALUE; putAat DIGIT                                       # memory[DIGIT] = DIGIT_VALUE   (B holds the address in DIGIT)
	inc DIGIT                                                    # DIGIT = DIGIT + 1
	goto NEXT_POWER
@ FITS
	putA REST                                                    # REST = REST - POWER   (A still holds the difference)
	inc DIGIT_VALUE                                                          # DIGIT_VALUE = DIGIT_VALUE + 1
	goto FITS_AGAIN

# The word 0 stops the CPU on its Breakpoint.
@ END
	non

# ---- Subroutines ----
origin 0x1800
# ADD_THREE: add the three cells starting at the address in ROW to SUM.
#     SUM = SUM + memory[ROW] + memory[ROW + 1] + memory[ROW + 2]
# The address is worked out in A, then load rgA rgA replaces it by the cell it points at.
@ ADD_THREE
	getAat ROW                                                   # A = memory[ROW]
	getB SUM; sum; putA SUM                                      # SUM = SUM + A
	getA ROW; lib 1; sum; load rgA rgA                           # A = memory[ROW + 1]
	getB SUM; sum; putA SUM                                      # SUM = SUM + A
	getA ROW; lib 2; sum; load rgA rgA                           # A = memory[ROW + 2]
	getB SUM; sum; putA SUM                                      # SUM = SUM + A
	ret

# PUSH_THREE: for the three cells starting at the address in ROW, note each one that must be looked
# at again.
#     N = ROW;     PUSH_IF_PASSED
#     N = ROW + 1; PUSH_IF_PASSED
#     N = ROW + 2; PUSH_IF_PASSED
@ PUSH_THREE
	getA ROW; putA N                                             # N = ROW
	do PUSH_IF_PASSED
	inc N                                                        # N = N + 1
	do PUSH_IF_PASSED
	inc N                                                        # N = N + 1
	do PUSH_IF_PASSED
	ret

# PUSH_IF_PASSED: put the address N on the to-do stack if the cell there is a roll and the walk has
# already passed it.
#     if memory[N] == 16 and N < P: memory[TOP] = N; TOP = TOP + 1
@ PUSH_IF_PASSED
	getAat N                                                     # A = memory[N]
	lib 16                                                       # B = 16
	if_neq PUSH_NOT                                              # not a roll
	getA N; getB P; sub                                          # A - B is negative when N < P
	if_nega PUSH_IT
@ PUSH_NOT
	ret
@ PUSH_IT
	getA N; putAat TOP                                           # memory[TOP] = N   (B holds the address in TOP)
	inc TOP                                                      # TOP = TOP + 1
	ret

# ---- Powers of ten for the decimal digits, then 0 ----
origin 0x1E00
10000; 1000; 100; 10; 1; 0

# ---- The grid: 138 rows of 138 cells ----
# One word per cell: 1 = empty, 16 = a roll; a 0 ends each row; one more 0 ends the grid.
origin 0x2000
# row 1: @@@@@@..@@@.@@.@@@@.@@@.@.@@@@@..@...@@@@@@@@.@@.@@@@@.@...@.@@@.@@@.@....@@@..@@@@@@@@.@@..@.@@..@@.@@@@@@.@@@@.@...@@.@.@@.@...@@.@.@@..
16; 16; 16; 16; 16; 16; 1; 1; 16; 16; 16; 1; 16; 16; 1; 16; 16; 16; 16; 1; 16; 16; 16; 1; 16; 1; 16; 16; 16; 16; 16; 1; 1; 16; 1; 1; 1; 16; 16; 16; 16; 16; 16; 16; 16; 1; 16; 16; 1; 16; 16; 16; 16; 16; 1; 16; 1; 1; 1; 16; 1; 16; 16; 16; 1; 16; 16; 16; 1; 16; 1; 1; 1; 1; 16; 16; 16; 1; 1; 16; 16; 16; 16; 16; 16; 16; 16; 1; 16; 16; 1; 1; 16; 1; 16; 16; 1; 1; 16; 16; 1; 16; 16; 16; 16; 16; 16; 1; 16; 16; 16; 16; 1; 16; 1; 1; 1; 16; 16; 1; 16; 1; 16; 16; 1; 16; 1; 1; 1; 16; 16; 1; 16; 1; 16; 16; 1; 1; 0
# row 2: .@@@@.@@@@.@@@@@.@@@.@..@.@@..@.@@..@.@@@.@@.@@.@@....@@@.@@@@@@@@.@@.@@.@.@@@@@.@@@@@.@..@@..@@@@@.@..@@@@@@.@.@@.@@.@.@.@@.@.@@.@.@.@@@@
1; 16; 16; 16; 16; 1; 16; 16; 16; 16; 1; 16; 16; 16; 16; 16; 1; 16; 16; 16; 1; 16; 1; 1; 16; 1; 16; 16; 1; 1; 16; 1; 16; 16; 1; 1; 16; 1; 16; 16; 16; 1; 16; 16; 1; 16; 16; 1; 16; 16; 1; 1; 1; 1; 16; 16; 16; 1; 16; 16; 16; 16; 16; 16; 16; 16; 1; 16; 16; 1; 16; 16; 1; 16; 1; 16; 16; 16; 16; 16; 1; 16; 16; 16; 16; 16; 1; 16; 1; 1; 16; 16; 1; 1; 16; 16; 16; 16; 16; 1; 16; 1; 1; 16; 16; 16; 16; 16; 16; 1; 16; 1; 16; 16; 1; 16; 16; 1; 16; 1; 16; 1; 16; 16; 1; 16; 1; 16; 16; 1; 16; 1; 16; 1; 16; 16; 16; 16; 0
# row 3: @@@.@.@@@@@@@.@..@@..@@@....@..@@@@@@..@@..@.@@@..@@..@@@@@@@@@..@@@@@.@.@.@@@@@...@@.@@@..@@@@.@..@@@..@@@@@..@.@.@@@@@..@@@@@..@@@@.@@@@
16; 16; 16; 1; 16; 1; 16; 16; 16; 16; 16; 16; 16; 1; 16; 1; 1; 16; 16; 1; 1; 16; 16; 16; 1; 1; 1; 1; 16; 1; 1; 16; 16; 16; 16; 16; 16; 1; 1; 16; 16; 1; 1; 16; 1; 16; 16; 16; 1; 1; 16; 16; 1; 1; 16; 16; 16; 16; 16; 16; 16; 16; 16; 1; 1; 16; 16; 16; 16; 16; 1; 16; 1; 16; 1; 16; 16; 16; 16; 16; 1; 1; 1; 16; 16; 1; 16; 16; 16; 1; 1; 16; 16; 16; 16; 1; 16; 1; 1; 16; 16; 16; 1; 1; 16; 16; 16; 16; 16; 1; 1; 16; 1; 16; 1; 16; 16; 16; 16; 16; 1; 1; 16; 16; 16; 16; 16; 1; 1; 16; 16; 16; 16; 1; 16; 16; 16; 16; 0
# row 4: ..@@.@@@@.@@.@.@@@@...@@@.@@@.@.@@@@@@...@@@..@.@@@@@@..@@@@@.@@@@@.@@@@@@@..@.@.@@@@@......@@..@@@@.@@@@@.@@...@@@@@@@.@@@@@..@@@@@.@..@.
1; 1; 16; 16; 1; 16; 16; 16; 16; 1; 16; 16; 1; 16; 1; 16; 16; 16; 16; 1; 1; 1; 16; 16; 16; 1; 16; 16; 16; 1; 16; 1; 16; 16; 16; 16; 16; 16; 1; 1; 1; 16; 16; 16; 1; 1; 16; 1; 16; 16; 16; 16; 16; 16; 1; 1; 16; 16; 16; 16; 16; 1; 16; 16; 16; 16; 16; 1; 16; 16; 16; 16; 16; 16; 16; 1; 1; 16; 1; 16; 1; 16; 16; 16; 16; 16; 1; 1; 1; 1; 1; 1; 16; 16; 1; 1; 16; 16; 16; 16; 1; 16; 16; 16; 16; 16; 1; 16; 16; 1; 1; 1; 16; 16; 16; 16; 16; 16; 16; 1; 16; 16; 16; 16; 16; 1; 1; 16; 16; 16; 16; 16; 1; 16; 1; 1; 16; 1; 0
# row 5: @..@@..@@@@@@@@@@.@@@.@..@@.@@@.@@.@@@@@.@.@@@@.@.@@.@@@..@@.@..@@@.@@@@.@@@..@@.@.@.@.@.@..@@@@@.@.@@@@@@@@.@@@@@@@@@@.@.@.@@@@.@..@@@.@@
16; 1; 1; 16; 16; 1; 1; 16; 16; 16; 16; 16; 16; 16; 16; 16; 16; 1; 16; 16; 16; 1; 16; 1; 1; 16; 16; 1; 16; 16; 16; 1; 16; 16; 1; 16; 16; 16; 16; 16; 1; 16; 1; 16; 16; 16; 16; 1; 16; 1; 16; 16; 1; 16; 16; 16; 1; 1; 16; 16; 1; 16; 1; 1; 16; 16; 16; 1; 16; 16; 16; 16; 1; 16; 16; 16; 1; 1; 16; 16; 1; 16; 1; 16; 1; 16; 1; 16; 1; 16; 1; 1; 16; 16; 16; 16; 16; 1; 16; 1; 16; 16; 16; 16; 16; 16; 16; 16; 1; 16; 16; 16; 16; 16; 16; 16; 16; 16; 16; 1; 16; 1; 16; 1; 16; 16; 16; 16; 1; 16; 1; 1; 16; 16; 16; 1; 16; 16; 0
