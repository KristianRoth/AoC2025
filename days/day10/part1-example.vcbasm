# Advent of Code 2025, day 10 part 1 (Factory), with the puzzle's example as input (answer 7)
#
# THE PUZZLE
# Each line of the input is a machine: a row of indicator lights with the pattern they must show, and a
# number of buttons, each wired to some of the lights. All lights start off; pushing a button turns
# each of its lights from off to on or from on to off. The answer is the fewest pushes that make every
# machine show its pattern, added up over all machines. (The joltages at the end of a line are not used.)
#
# THE IDEA
# The lights of a machine are the bits of one word: bit 0 is the first light. A button is the word with
# the bits of its lights, and pushing it is "state xor button". The fewest pushes from "all off" to the
# pattern is a shortest way through the states, found by going outwards from "all off" one push at a
# time (a breadth-first search): first every state one push away, then every new state one push from
# those, and so on, never visiting a state twice. The first time the pattern turns up, the number of
# pushes is the fewest. For the example's first machine, [.##.] = 6:
#     0 pushes: 0        1 push: 8, 10, 4, 12, 5, 3        2 pushes: 8 xor 10 = 2, ..., 5 xor 3 = 6: found
# VISITED has one word per state. A state is visited when its word holds the machine's number, so the
# table never has to be cleared between machines.
#
# THE WHOLE PROGRAM IN PSEUDO CODE
#     TOTAL = 0; STAMP = 0
#     for each machine:
#         TARGET = the pattern as a word; the buttons as words (below)
#         if TARGET == 0: continue
#         STAMP = STAMP + 1; VISITED[0] = STAMP
#         the queue = [state 0 with 0 pushes]
#         for S, with its pushes, taken from the front of the queue:
#             for each button B:
#                 T = S xor B
#                 if T == TARGET: TOTAL = TOTAL + (the pushes of S) + 1; go to the next machine
#                 if VISITED[T] != STAMP: VISITED[T] = STAMP; put T with (the pushes of S) + 1 at the end of the queue
#     write TOTAL as five decimal digits
#     stop
#
# THE RESULT, when the CPU stops on the Breakpoint at END
#   0x0100         the total as one 16-bit word
#   0x0110-0x0114  the total as five decimal digits, one per word, most significant first
#
# THE INPUT (rule 1 of RULES.md), at 0x2000
# Machine after machine, as in the puzzle's text:
#     one word per light: 0 for off (.), 1 for on (#); then 0xFFFF
#     for each button: the numbers of its lights, then 0xFFFE; after the last button 0xFFFF
#     the joltages, one word each; then 0xFFFF
# After the last machine comes one more 0xFFFF.
# Built-in limits: at most 12 lights and 256 buttons a machine; a button names a light once; every
# machine can be made to show its pattern; the total stays below 65,536.
#
# ONE WORD IS ENOUGH
# Every value here fits in 16 bits, so each variable is one memory word. The idioms used everywhere
# (v is a variable's address, below 0x1000):
#     getA v                   A = the word at v   (lia v; load rgA rgA: lia puts the address in A, load replaces it)
#     getB v                   B = the word at v
#     putA v                   the word at v = A   (this uses up B)
#     getAat p / putAat p      the same for the word the pointer p points at
#     copy v w                 w = v
#     if_eq L                  compares A with B as they are now
#     sub; if_carry L          after A - B: taken when A >= B
# What each instruction does exactly is in findings/cpu-instructions.md.
#
# MEMORY MAP
#   0x0100-0x013F  variables            0x1E00-  POWERS: 10000, 1000, 100, 10, 1, 0
#   0x0200-0x02FF  the buttons of the machine at hand, one word each
#   0x1000-        the program          0x1E10-  BITS: 1, 2, 4, ..., 32768: the word for light 0, 1, 2, ...
#   0x2000-        the input (3 machines end at 0x205E)
#   0x8000-0x8FFF  VISITED: one word per state      0x9000-0x9FFF  the queue: the states
#   0xA000-0xAFFF  the pushes of the states in the queue (the word 0x1000 after the state's)
#   0xFF00         where the CPU starts

# ---- The CPU's instructions as symbols (day 1's table without its _32 names, which the CPU ignores) ----
symbol nop 0b0000_0000_0000_0000            # the word 0: stops the CPU (the same word as non)
symbol ld  0b0010_0000_0000_0000            # load a register from memory (used through the load macro)
symbol lia 0b0011_0000_0000_0000            # lia n: A = n (0 to 4095), upper half 0
symbol lib 0b0100_0000_0000_0000            # lib n: B = n (0 to 4095), upper half 0
symbol sto 0b0101_0000_0000_0000            # store a register to memory (used through the store macro)

macro  load  { ld  | a? | (b? >> 6) }       # load X Y: X = the word at the address in Y
macro  store { sto | a? | (b? >> 6) }       # store X Y: the word at the address in Y = X

symbol sum    0b0110_0100_0000_0000         # A = A + B (32 bits), sets zero, carry, nega
symbol sub    0b0110_0010_0000_0000         # A = A - B (32 bits), sets zero, carry, nega
symbol shf    0b0110_0001_0000_0000         # shf | k: A = A shifted left by k (0 to 15)
symbol and    0b0110_0000_1000_0000         # A = A and B
symbol or     0b0110_0000_0100_0000         # A = A or B
symbol xor    0b0110_0000_0010_0000         # A = A xor B
symbol neg    0b0110_0000_0001_0000         # A = every bit of A flipped

symbol psh 0b1010_0000_0000_0000            # psh X: push the 16 bits of X
symbol pop 0b1011_0000_0000_0000            # pop X: pop 16 bits into X

symbol jmp  0b1100_0000_0000_0000           # jmp; L: go to L.  jmp c; L: go to L when c holds
symbol call 0b1110_0000_0000_0000           # call; L: run the subroutine at L
symbol ret  0b1111_0000_0000_0000           # return from a subroutine

# The registers, as load, store, psh and pop name them
symbol rgAH 0b1000_0000_0000                # the upper 16 bits of A
symbol rgA  0b0100_0000_0000                # the lower 16 bits of A
symbol rgBH 0b0010_0000_0000                # the upper 16 bits of B
symbol rgB  0b0001_0000_0000                # the lower 16 bits of B
symbol rgSP 0b0000_1000_0000                # the program counter (leave alone)
symbol rgSB 0b0000_0100_0000                # the stack pointer (leave alone)
symbol non  0                               # stops the CPU (Breakpoint): the end of the program

# The conditions of jmp
symbol zero  0b1000_0000_0000               # the last sum or sub gave 0
symbol carry 0b0100_0000_0000               # the last sum carried, or the last sub did not borrow (A >= B)
symbol nega  0b0010_0000_0000               # the last sub went below 0 (A < B)
symbol eq    0b0001_0000_0000               # A == B right now
symbol neq   0b0000_1000_0000               # A != B right now

# ---- Macros for the common operations (explained in the README). A macro cannot use another macro, so
#      load and store are spelled out here. v: a variable, p: a variable holding an address, L: a label ----
macro getA     { lia a?; ld | rgA | (rgA >> 6) }                                              # A = v
macro getB     { lib a?; ld | rgB | (rgB >> 6) }                                              # B = v
macro putA     { lib a?; sto | rgA | (rgB >> 6) }                                             # v = A (uses B)
macro getAat   { lia a?; ld | rgA | (rgA >> 6); ld | rgA | (rgA >> 6) }                       # A = the word p points at
macro putAat   { lib a?; ld | rgB | (rgB >> 6); sto | rgA | (rgB >> 6) }                      # the word p points at = A (uses B)
macro inc      { lia a?; ld | rgA | (rgA >> 6); lib 1; sum; lib a?; sto | rgA | (rgB >> 6) }  # v = v + 1 (uses A and B)
macro goto     { jmp; a? }                                                                    # go to L
macro if_eq    { jmp eq; a? }                                                                 # go to L when A == B
macro do       { call; a? }                                                                   # call the subroutine L
macro if_carry { jmp carry; a? }                                                              # go to L after a sub when A >= B
macro copy     { lia a?; ld | rgA | (rgA >> 6); lib b?; sto | rgA | (rgB >> 6) }                      # w = v (uses A and B)

# ---- Variables (all below 0x1000, so lia/lib can address them) ----
# The result
pointer TOTAL 0x0100 0
# IN: the address of the next word of the input
pointer IN 0x0120 0x2000
# TARGET: the pattern of the machine as a word. BIT: the word for the light being read. MASK: a button being put together
pointer TARGET 0x0121 0
pointer BIT 0x0122 0
pointer MASK 0x0123 0
# BEND: the address after the machine's last button. BP: the button being tried
pointer BEND 0x0124 0
pointer BP 0x0125 0
# STAMP: the number of the machine. QH, QT: the front of the queue and its end
pointer STAMP 0x0126 0
pointer QH 0x0127 0
pointer QT 0x0128 0
# S: the state taken from the queue. PUSHES: its pushes + 1. T: S after one more push. ADR: an address worked out
pointer S 0x0129 0
pointer PUSHES 0x012A 0
pointer T 0x012B 0
pointer ADR 0x012C 0
# For the decimal digits: what is left of the total, the current power of ten, how often it fitted
pointer REST 0x012D 0
pointer POWER 0x012E 0
pointer DIGIT_VALUE 0x012F 0
# Pointers: DIGIT the next digit to write, POW the next power of ten
pointer DIGIT 0x0130 0x0110
pointer POW 0x0131 0x1E00
# Constants that do not fit an instruction's place for a number
pointer BUTTONS 0x0132 0x0200
pointer BITS 0x0133 0x1E10
pointer VISITED 0x0134 0x8000
pointer QUEUE 0x0135 0x9000
pointer TO_PUSHES 0x0136 0x1000
pointer END_MARK 0x0137 0xFFFF
pointer BUTTON_MARK 0x0138 0xFFFE

# ---- The CPU starts at 0xFF00 ----
origin 0xFF00
goto MAIN

origin 0x1000
@ MAIN
# ==== read a machine: its pattern ====
#     if memory[IN] == 0xFFFF: goto ALL_DONE                # no machine is left
#     TARGET = 0; BIT = 1
#     while memory[IN] != 0xFFFF:
#         if memory[IN] == 1: TARGET = TARGET + BIT
#         BIT = BIT * 2; IN = IN + 1
#     IN = IN + 1
@ NEXT_MACHINE
	getAat IN; getB END_MARK                                     # A = memory[IN], B = 0xFFFF
	if_eq ALL_DONE                                               # the end of the input
	lia 0; putA TARGET                                           # TARGET = 0
	lia 1; putA BIT                                              # BIT = 1
@ LIGHT
	getAat IN; getB END_MARK                                     # A = memory[IN], B = 0xFFFF
	if_eq LIGHTS_DONE                                            # the end of the lights
	lib 0                                                        # B = 0
	if_eq LIGHT_OFF                                              # this light is to be off
	getA TARGET; getB BIT; sum; putA TARGET                      # TARGET = TARGET + BIT
@ LIGHT_OFF
	getA BIT; shf | 1; putA BIT                                  # BIT = BIT * 2
	inc IN                                                       # IN = IN + 1
	goto LIGHT
@ LIGHTS_DONE
	inc IN                                                       # IN = IN + 1: past the 0xFFFF
	copy BUTTONS BEND                                            # BEND = BUTTONS: no button yet

# ==== its buttons ====
#     while memory[IN] != 0xFFFF:
#         MASK = 0
#         while memory[IN] != 0xFFFE: MASK = MASK + BITS[memory[IN]]; IN = IN + 1
#         memory[BEND] = MASK; BEND = BEND + 1; IN = IN + 1
#     IN = IN + 1
@ BUTTON
	getAat IN; getB END_MARK                                     # A = memory[IN], B = 0xFFFF
	if_eq BUTTONS_DONE                                           # the end of the buttons
	lia 0; putA MASK                                             # MASK = 0
@ BUTTON_LIGHT
	getAat IN; getB BUTTON_MARK                                  # A = memory[IN], B = 0xFFFE
	if_eq BUTTON_END                                             # the end of this button
	getB BITS; sum; load rgA rgA                                 # A = BITS[the number of the light]
	getB MASK; sum; putA MASK                                    # MASK = MASK + that
	inc IN                                                       # IN = IN + 1
	goto BUTTON_LIGHT
@ BUTTON_END
	getA MASK; putAat BEND                                       # memory[BEND] = MASK
	inc BEND                                                     # BEND = BEND + 1
	inc IN                                                       # IN = IN + 1: past the 0xFFFE
	goto BUTTON
@ BUTTONS_DONE
	inc IN                                                       # IN = IN + 1: past the 0xFFFF

# ==== step over its joltages ====
#     while memory[IN] != 0xFFFF: IN = IN + 1
#     IN = IN + 1
@ JOLTAGE
	getAat IN; getB END_MARK                                     # A = memory[IN], B = 0xFFFF
	if_eq JOLTAGES_DONE
	inc IN                                                       # IN = IN + 1
	goto JOLTAGE
@ JOLTAGES_DONE
	inc IN                                                       # IN = IN + 1: past the 0xFFFF

# ==== the fewest pushes ====
#     if TARGET == 0: goto NEXT_MACHINE
#     STAMP = STAMP + 1; VISITED[0] = STAMP
#     memory[QUEUE] = 0; its pushes = 0; QH = QUEUE; QT = QUEUE + 1
#     loop:
#         S = memory[QH]; PUSHES = (the pushes of S) + 1; QH = QH + 1
#         for BP = BUTTONS; BP != BEND; BP = BP + 1:
#             T = S xor memory[BP]
#             if T == TARGET: TOTAL = TOTAL + PUSHES; goto NEXT_MACHINE
#             if VISITED[T] != STAMP:
#                 VISITED[T] = STAMP; memory[QT] = T; the pushes of T = PUSHES; QT = QT + 1
	getA TARGET; lib 0                                           # A = TARGET, B = 0
	if_eq NEXT_MACHINE                                           # all lights off: nothing to push
	inc STAMP                                                    # STAMP = STAMP + 1
	putAat VISITED                                               # VISITED[0] = STAMP (A still holds STAMP)
	lia 0; putAat QUEUE                                          # the first state in the queue = 0
	getA QUEUE; getB TO_PUSHES; sum; lib 0; store rgB rgA        # its pushes = 0
	copy QUEUE QH                                                # QH = QUEUE
	lib 1; sum; putA QT                                          # QT = QUEUE + 1 (A still holds QUEUE)
@ NEXT_STATE
	getA QH; getB QT                                             # A = QH, B = QT
	if_eq NEXT_MACHINE                                           # the queue is empty: the pattern cannot be made (not in the puzzle)
	getAat QH; putA S                                            # S = memory[QH]
	getA QH; getB TO_PUSHES; sum; load rgA rgA                   # A = the pushes of S
	lib 1; sum; putA PUSHES                                      # PUSHES = that + 1
	inc QH                                                       # QH = QH + 1
	copy BUTTONS BP                                              # BP = the first button
@ NEXT_BUTTON
	getA BP; getB BEND                                           # A = BP, B = BEND
	if_eq NEXT_STATE                                             # every button has been tried on S
	getAat BP; getB S; xor; putA T                               # T = S xor the button
	getB TARGET                                                  # B = TARGET (A still holds T)
	if_eq FOUND                                                  # the pattern
	inc BP                                                       # BP = BP + 1
	getA T; getB VISITED; sum; putA ADR                          # ADR = the address of VISITED[T]
	load rgA rgA; getB STAMP                                     # A = VISITED[T], B = STAMP
	if_eq NEXT_BUTTON                                            # T was reached before, with no more pushes
	getA STAMP; putAat ADR                                       # VISITED[T] = STAMP
	getA T; putAat QT                                            # memory[QT] = T
	getA QT; getB TO_PUSHES; sum                                 # A = the address of its pushes
	getB PUSHES; store rgB rgA                                   # the pushes of T = PUSHES
	inc QT                                                       # QT = QT + 1
	goto NEXT_BUTTON
@ FOUND
	getA TOTAL; getB PUSHES; sum; putA TOTAL                     # TOTAL = TOTAL + PUSHES
	goto NEXT_MACHINE

# ==== write TOTAL as five decimal digits ====
# A digit is how often a power of ten fits into what is left. Without division that is counting:
#     REST = TOTAL
#     for POWER in 10000, 1000, 100, 10, 1:
#         DIGIT_VALUE = 0
#         while REST >= POWER: REST = REST - POWER; DIGIT_VALUE = DIGIT_VALUE + 1
#         memory[DIGIT] = DIGIT_VALUE; DIGIT = DIGIT + 1
# After sub, the carry flag is set when A >= B (no borrow).
@ ALL_DONE
	getA TOTAL; putA REST                                        # REST = TOTAL
@ NEXT_POWER
	getAat POW                                                   # A = memory[POW], the next power of ten
	putA POWER                                                   # POWER = A
	lib 0                                                        # B = 0
	if_eq END                                                    # a power of 0 ends the table
	inc POW                                                      # POW = POW + 1
	lia 0; putA DIGIT_VALUE                                      # DIGIT_VALUE = 0
@ FITS_AGAIN
	getA REST; getB POWER                                        # A = REST, B = POWER
	sub                                                          # A = REST - POWER
	if_carry FITS                                                # REST >= POWER: it fits once more
	getA DIGIT_VALUE; putAat DIGIT                                       # memory[DIGIT] = DIGIT_VALUE   (B holds the address in DIGIT)
	inc DIGIT                                                    # DIGIT = DIGIT + 1
	goto NEXT_POWER
@ FITS
	putA REST                                                    # REST = REST - POWER   (A still holds the difference)
	inc DIGIT_VALUE                                                          # DIGIT_VALUE = DIGIT_VALUE + 1
	goto FITS_AGAIN

# The word 0 stops the CPU on its Breakpoint.
@ END
	non
# ---- Powers of ten for the decimal digits, then 0 ----
origin 0x1E00
10000; 1000; 100; 10; 1; 0

# ---- The word for each light: 1, 2, 4, ... ----
origin 0x1E10
1; 2; 4; 8; 16; 32; 64; 128; 256; 512; 1024; 2048; 4096; 8192; 16384; 32768


# ---- The machines: 3, then 0xFFFF ----
origin 0x2000
# [.##.] (3) (1,3) (2) (2,3) (0,2) (0,1) {3,5,4,7}
0; 1; 1; 0; 0xFFFF
3; 0xFFFE; 1; 3; 0xFFFE; 2; 0xFFFE; 2; 3; 0xFFFE; 0; 2; 0xFFFE; 0; 1; 0xFFFE; 0xFFFF
3; 5; 4; 7; 0xFFFF
# [...#.] (0,2,3,4) (2,3) (0,4) (0,1,2) (1,2,3,4) {7,5,12,7,2}
0; 0; 0; 1; 0; 0xFFFF
0; 2; 3; 4; 0xFFFE; 2; 3; 0xFFFE; 0; 4; 0xFFFE; 0; 1; 2; 0xFFFE; 1; 2; 3; 4; 0xFFFE; 0xFFFF
7; 5; 12; 7; 2; 0xFFFF
# [.###.#] (0,1,2,3,4) (0,3,4) (0,1,2,4,5) (1,2) {10,11,11,5,10,5}
0; 1; 1; 1; 0; 1; 0xFFFF
0; 1; 2; 3; 4; 0xFFFE; 0; 3; 4; 0xFFFE; 0; 1; 2; 4; 5; 0xFFFE; 1; 2; 0xFFFE; 0xFFFF
10; 11; 11; 5; 10; 5; 0xFFFF
0xFFFF
