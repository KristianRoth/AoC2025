# Advent of Code 2025, day 2 part 1 (Gift Shop), with the puzzle's example as input (answer 1227775554)
#
# THE PUZZLE
# The input is a list of ID ranges. An ID is invalid when it is some digits written twice: 55, 6464,
# 123123. The answer is the sum of all invalid IDs inside the ranges.
#
# THE IDEA
# An invalid ID whose half has k digits is  h * (10^k + 1)  with h a k-digit number:
#     6464 = 64 * 101        123123 = 123 * 1001
# So for one k the invalid IDs are evenly spaced, 10^k + 1 apart:
#     k = 1:   11, 22, ..., 99                 step 11
#     k = 2:   1010, 1111, ..., 9999           step 101
#     k = 3:   100100, 101101, ..., 999999     step 1001
# The program never looks at an ID that is not invalid. For each range and each k it jumps to the first
# invalid ID that is not below the range's first ID, then adds them up one step at a time until it
# passes the range's last ID. About 1,700 additions for the real input, instead of 2.6 million checks.
#
# THE WHOLE PROGRAM IN PSEUDO CODE
#     SUM = 0
#     for each range LO..HI in the input:
#         for k = 1..5:
#             C = smallest candidate of k          # 10^(k-1) * (10^k + 1)
#             LAST = largest candidate of k        # 10^(2k) - 1
#             if LAST < LO: continue               # the range lies above every candidate of this k
#             for S in (10^k+1)*10^(k-1), ..., (10^k+1)*10, (10^k+1):    # big steps first
#                 while C + S < LO: C = C + S      # STEP_UP: at most 9 times per step size
#             # now C is the largest candidate below LO (or the smallest candidate, if that is not below LO)
#             if C < LO: C = C + S                 # S is 10^k + 1 here: the first candidate in the range
#             while C <= HI and C <= LAST:
#                 SUM = SUM + C
#                 C = C + S
#     write SUM as decimal digits                  # with the same STEP_UP, see ALL_RANGES_DONE
#     stop
#
# The CPU cannot multiply or divide, so the candidates and step sizes for every k are in a table at
# 0x3000 (K_TABLE), and "jump to the first candidate" is done by walking up in decimal steps.
#
# THE RESULT, when the CPU stops on the Breakpoint at END
#   0x0100-0x0102  the sum as three 16-bit words, low word first
#   0x0110-0x011E  the sum as 15 decimal digits, one per word, most significant first
#
# THE INPUT (rule 1 of RULES.md), at 0x2000
# Each range is its first and last ID. Each ID is three 16-bit words, low word first. Three zero words
# end the list. Built-in limits: IDs of at most 10 digits (k up to 5), a sum below 2^48.
#
# NUMBERS WIDER THAN A REGISTER
# IDs go up to 9,999,999,999, which needs 34 bits; the sum needs more. A number is therefore three
# memory words of 16 bits: NAME_0 (lowest), NAME_1, NAME_2. The CPU's registers are 32 bits wide, so two
# words can be added in a register without losing the carry: the carry ends up in the upper half, rgAH.
#
# THE FOUR IDIOMS used everywhere below (v is a variable's address, below 0x1000)
#     getA v                   A = the word at v, upper half 0   (lia v; load rgA rgA: lia puts the address in A, load replaces it)
#     getB v                   B = the word at v, upper half 0
#     putA v                   the word at v = the lower half of A   (this uses up B)
#     carryB                   B = the upper half of A: the carry of the addition just made
# What each instruction does exactly is in findings/cpu-instructions.md.
#
# MEMORY MAP
#   0x0100-0x0165  variables            0x2000-  the input
#   0x1000-        the main program     0x3000-  K_TABLE: candidates and steps per k
#   0x1800-        subroutines          0x3100-  POWERS: powers of ten for the decimal digits
#   0xFF00         where the CPU starts

# ---- The CPU's instructions as symbols (day 1's table without its _32 names, which the CPU ignores) ----
symbol nop 0b0000_0000_0000_0000            # the word 0: stops the CPU (the same word as non)
symbol ld  0b0010_0000_0000_0000            # load a register from memory (used through the load macro)
symbol lia 0b0011_0000_0000_0000            # lia n: A = n (0 to 4095), upper half 0
symbol lib 0b0100_0000_0000_0000            # lib n: B = n (0 to 4095), upper half 0
symbol sto 0b0101_0000_0000_0000            # store a register to memory (used through the store macro)

macro  load  { ld  | a? | (b? >> 6) }       # load X Y: X = the word at the address in Y
macro  store { sto | a? | (b? >> 6) }       # store X Y: the word at the address in Y = X

symbol sum    0b0110_0100_0000_0000         # A = A + B (32 bits), sets zero, carry, nega
symbol sub    0b0110_0010_0000_0000         # A = A - B (32 bits), sets zero, carry, nega
symbol shf    0b0110_0001_0000_0000         # shf | k: A = A shifted left by k (0 to 15)
symbol and    0b0110_0000_1000_0000         # A = A and B
symbol or     0b0110_0000_0100_0000         # A = A or B
symbol xor    0b0110_0000_0010_0000         # A = A xor B
symbol neg    0b0110_0000_0001_0000         # A = every bit of A flipped

symbol psh 0b1010_0000_0000_0000            # psh X: push the 16 bits of X
symbol pop 0b1011_0000_0000_0000            # pop X: pop 16 bits into X

symbol jmp  0b1100_0000_0000_0000           # jmp; L: go to L.  jmp c; L: go to L when c holds
symbol call 0b1110_0000_0000_0000           # call; L: run the subroutine at L
symbol ret  0b1111_0000_0000_0000           # return from a subroutine

# The registers, as load, store, psh and pop name them
symbol rgAH 0b1000_0000_0000                # the upper 16 bits of A
symbol rgA  0b0100_0000_0000                # the lower 16 bits of A
symbol rgBH 0b0010_0000_0000                # the upper 16 bits of B
symbol rgB  0b0001_0000_0000                # the lower 16 bits of B
symbol rgSP 0b0000_1000_0000                # the program counter (leave alone)
symbol rgSB 0b0000_0100_0000                # the stack pointer (leave alone)
symbol non  0                               # stops the CPU (Breakpoint): the end of the program

# The conditions of jmp
symbol zero  0b1000_0000_0000               # the last sum or sub gave 0
symbol carry 0b0100_0000_0000               # the last sum carried, or the last sub did not borrow (A >= B)
symbol nega  0b0010_0000_0000               # the last sub went below 0 (A < B)
symbol eq    0b0001_0000_0000               # A == B right now
symbol neq   0b0000_1000_0000               # A != B right now

# ---- Macros for the common operations (explained in the README). A macro cannot use another macro, so
#      load and store are spelled out here. v: a variable, p: a variable holding an address, L: a label ----
macro getA    { lia a?; ld | rgA | (rgA >> 6) }                                              # A = v
macro getB    { lib a?; ld | rgB | (rgB >> 6) }                                              # B = v
macro putA    { lib a?; sto | rgA | (rgB >> 6) }                                             # v = A (uses B)
macro putAat  { lib a?; ld | rgB | (rgB >> 6); sto | rgA | (rgB >> 6) }                      # the word p points at = A (uses B)
macro inc     { lia a?; ld | rgA | (rgA >> 6); lib 1; sum; lib a?; sto | rgA | (rgB >> 6) }  # v = v + 1 (uses A and B)
macro goto    { jmp; a? }                                                                    # go to L
macro if_eq   { jmp eq; a? }                                                                 # go to L when A == B
macro if_neq  { jmp neq; a? }                                                                # go to L when A != B
macro do      { call; a? }                                                                   # call the subroutine L
macro carryB  { psh rgAH; pop rgB }                                                          # B = the carry of the last sum
macro if_nega { jmp nega; a? }                                                               # go to L after a sub when A < B

# ---- Variables (all below 0x1000, so lia/lib can address them) ----
# The result
pointer SUM_0 0x0100 0
pointer SUM_1 0x0101 0
pointer SUM_2 0x0102 0
# The current range: its first and last ID. HI must follow LO.
pointer LO_0 0x0120 0
pointer LO_1 0x0121 0
pointer LO_2 0x0122 0
pointer HI_0 0x0123 0
pointer HI_1 0x0124 0
pointer HI_2 0x0125 0
# The current half length k: NEXT is where the next k starts in the table, C the candidate ID,
# LAST the largest candidate for this k. C and LAST must follow NEXT.
pointer NEXT 0x0130 0
pointer C_0 0x0131 0
pointer C_1 0x0132 0
pointer C_2 0x0133 0
pointer LAST_0 0x0134 0
pointer LAST_1 0x0135 0
pointer LAST_2 0x0136 0
# S is the current step, T a trial value, COUNT how often STEP_UP stepped
pointer S_0 0x0140 0
pointer S_1 0x0141 0
pointer S_2 0x0142 0
pointer T_0 0x0143 0
pointer T_1 0x0144 0
pointer T_2 0x0145 0
pointer COUNT 0x0146 0
# The constant 1 as a number
pointer ONE_0 0x0150 1
pointer ONE_1 0x0151 0
pointer ONE_2 0x0152 0
# Pointers: SRC and DST for COPY_1, IN the next input word, DIGIT the next digit to write,
# and the addresses of the two tables
pointer SRC 0x0160 0
pointer DST 0x0161 0
pointer IN 0x0162 0x2000
pointer DIGIT 0x0163 0x0110
pointer K_TABLE 0x0164 0x3000
pointer POWERS 0x0165 0x3100

# ---- The CPU starts at 0xFF00 ----
origin 0xFF00
goto MAIN

origin 0x1000
@ MAIN
# ==== for each range LO..HI in the input ====
#     LO = input[IN], HI = input[IN + 3]; IN = IN + 6
#     if LO == 0: goto ALL_RANGES_DONE
#     SRC = K_TABLE                      # start again at k = 1
# COPY_3 copies three words from the address in SRC to the address in DST and moves both on, so two
# calls fill LO and then HI, which lies right behind LO.
@ NEXT_RANGE
	getA IN; putA SRC                                                                    # SRC = IN
	lia LO_0; putA DST                                                                   # DST = the address of LO
	do COPY_3                                                                            # LO = the range's first ID
	do COPY_3                                                                            # HI = the range's last ID
	getA SRC; putA IN                                                                    # IN = SRC, now at the next range
	# A first ID of 0 ends the list: OR the three words of LO together and compare with 0.
	# (eq compares A with B as they are now, so no subtraction is needed.)
	getA LO_0; getB LO_1; or; getB LO_2; or; lib 0
	if_eq ALL_RANGES_DONE
	getA K_TABLE; putA SRC                                                               # SRC = the start of the table: k = 1

# ==== for k = 1..5 ====
# SRC points at this k's table entry: [address of the next entry] [smallest candidate] [largest candidate]
# [step sizes, largest first]. NEXT, C and LAST lie behind each other, so three copies fill them.
#     NEXT = table[SRC]; C = smallest candidate; LAST = largest candidate
#     if NEXT == 0: goto NEXT_RANGE      # the table is finished: all k done for this range
#     if LAST < LO: goto SKIP_K          # every candidate of this k is below the range
@ NEXT_K
	lia NEXT; putA DST                                                                   # DST = the address of NEXT
	do COPY_1                                                                            # NEXT = where the next k's entry starts
	do COPY_3                                                                            # C = the smallest candidate of this k
	do COPY_3                                                                            # LAST = the largest candidate of this k
	getA NEXT; lib 0                                                                     # NEXT == 0 marks the end of the table
	if_eq NEXT_RANGE
	# No candidate of this k is in the range when even the largest is below LO
	# compare LAST with LO, highest word first; afterwards: nega if LAST < LO, zero if equal
	getA LAST_2; getB LO_2; if_neq CMP_1                                                 # word 2 differs: it decides
	getA LAST_1; getB LO_1; if_neq CMP_1                                                 # word 1 differs: it decides
	getA LAST_0; getB LO_0                                                               # otherwise word 0 decides
@ CMP_1
	sub                                                                                  # A - B sets the flags zero and nega
	if_nega SKIP_K

# ==== walk C up to the largest candidate below LO ====
#     while SRC != NEXT:                 # the step sizes are the rest of this k's entry
#         S = table[SRC]; SRC = SRC + 3
#         STEP_UP                        # while C + S < LO: C = C + S
# Example, k = 2 and LO = 3308: C starts at 1010. Step 1010: 2020, 3030 (4040 is too far). Step 101:
# 3131, 3232 (3333 is too far). C = 3232 is the largest candidate below 3308.
# This is long division done by walking: it finds h in  h * 101  one decimal digit at a time.
@ NEXT_STEP
	getA SRC; getB NEXT
	if_eq STEPS_DONE                                                                     # SRC reached the next entry: no step sizes left
	lia S_0; putA DST                                                                    # DST = the address of S
	do COPY_3                                                                            # S = the next step size
	do STEP_UP                                                                           # while C + S < LO: C = C + S
	goto NEXT_STEP

# ==== step onto the first candidate that is not below LO ====
# S is now the smallest step, 10^k + 1: the distance between two candidates.
#     if C < LO: C = C + S
# (C is not below LO only when even the smallest candidate of this k is at or above LO.)
@ STEPS_DONE
	# compare C with LO, highest word first; afterwards: nega if C < LO, zero if equal
	getA C_2; getB LO_2; if_neq CMP_2                                                    # word 2 differs: it decides
	getA C_1; getB LO_1; if_neq CMP_2                                                    # word 1 differs: it decides
	getA C_0; getB LO_0                                                                  # otherwise word 0 decides
@ CMP_2
	sub                                                                                  # A - B sets the flags zero and nega
	if_nega ONE_MORE
	goto ADD_CANDIDATES
@ ONE_MORE
	# C = C + S      (three words, lowest first; the carry travels in rgAH)
	getA C_0; getB S_0; sum; putA C_0                                                    # word 0: A = C_0 + S_0
	carryB; getA C_1; sum; getB S_1; sum; putA C_1                                                   # word 1: A = carry + C_1 + S_1
	carryB; getA C_2; sum; getB S_2; sum; putA C_2                                                   # word 2: A = carry + C_2 + S_2

# ==== add up the candidates inside the range ====
#     while C <= HI and C <= LAST:
#         SUM = SUM + C
#         C = C + S
# The tests are written the other way round: leave when HI < C, leave when LAST < C.
# Leaving goes to NEXT_K; SRC already points at the next k's entry.
@ ADD_CANDIDATES
	# compare HI with C, highest word first; afterwards: nega if HI < C, zero if equal
	getA HI_2; getB C_2; if_neq CMP_3                                                    # word 2 differs: it decides
	getA HI_1; getB C_1; if_neq CMP_3                                                    # word 1 differs: it decides
	getA HI_0; getB C_0                                                                  # otherwise word 0 decides
@ CMP_3
	sub                                                                                  # A - B sets the flags zero and nega
	if_nega NEXT_K
	# compare LAST with C, highest word first; afterwards: nega if LAST < C, zero if equal
	getA LAST_2; getB C_2; if_neq CMP_4                                                  # word 2 differs: it decides
	getA LAST_1; getB C_1; if_neq CMP_4                                                  # word 1 differs: it decides
	getA LAST_0; getB C_0                                                                # otherwise word 0 decides
@ CMP_4
	sub                                                                                  # A - B sets the flags zero and nega
	if_nega NEXT_K
	# SUM = SUM + C      (three words, lowest first; the carry travels in rgAH)
	getA SUM_0; getB C_0; sum; putA SUM_0                                                # word 0: A = SUM_0 + C_0
	carryB; getA SUM_1; sum; getB C_1; sum; putA SUM_1                                                   # word 1: A = carry + SUM_1 + C_1
	carryB; getA SUM_2; sum; getB C_2; sum; putA SUM_2                                                   # word 2: A = carry + SUM_2 + C_2
	# C = C + S      (three words, lowest first; the carry travels in rgAH)
	getA C_0; getB S_0; sum; putA C_0                                                    # word 0: A = C_0 + S_0
	carryB; getA C_1; sum; getB S_1; sum; putA C_1                                                   # word 1: A = carry + C_1 + S_1
	carryB; getA C_2; sum; getB S_2; sum; putA C_2                                                   # word 2: A = carry + C_2 + S_2
	goto ADD_CANDIDATES

# Skip this k without reading its step sizes:  SRC = NEXT
@ SKIP_K
	getA NEXT; putA SRC
	goto NEXT_K

# ==== write SUM as decimal digits ====
# A digit is how often a power of ten fits into what is left. Without division that is counting:
#     LO = SUM + 1; C = 0
#     for S in 10^14, 10^13, ..., 10, 1:
#         STEP_UP                        # while C + S < LO: C = C + S; COUNT = COUNT + 1
#         memory[DIGIT] = COUNT; DIGIT = DIGIT + 1
# C climbs from 0 to exactly SUM, and COUNT is one decimal digit each time. "C + S < SUM + 1" is
# "C + S <= SUM", which is why LO is set to SUM + 1: STEP_UP only knows "below LO".
@ ALL_RANGES_DONE
	# LO = SUM + ONE      (three words, lowest first; the carry travels in rgAH)
	getA SUM_0; getB ONE_0; sum; putA LO_0                                               # word 0: A = SUM_0 + ONE_0
	carryB; getA SUM_1; sum; getB ONE_1; sum; putA LO_1                                                   # word 1: A = carry + SUM_1 + ONE_1
	carryB; getA SUM_2; sum; getB ONE_2; sum; putA LO_2                                                   # word 2: A = carry + SUM_2 + ONE_2
	lia 0; putA C_0; putA C_1; putA C_2                                                  # C = 0
	getA POWERS; putA SRC                                                                # SRC = the table of powers of ten
@ NEXT_DIGIT
	lia S_0; putA DST                                                                    # DST = the address of S
	do COPY_3                                                                            # S = the next power of ten
	# A power of 0 ends the table
	getA S_0; getB S_1; or; getB S_2; or; lib 0
	if_eq END
	do STEP_UP                                                                           # COUNT = how often S fits
	getA COUNT; putAat DIGIT                                                             # memory[DIGIT] = COUNT   (B holds the address in DIGIT)
	inc DIGIT                                                                            # DIGIT = DIGIT + 1
	goto NEXT_DIGIT

# The word 0 stops the CPU on its Breakpoint.
@ END
	non

# ---- Subroutines ----
origin 0x1800
# STEP_UP: add S to C as often as the result stays below LO. COUNT is the number of steps.
#     COUNT = 0
#     loop:
#         T = C + S                      # try the step in T first
#         if not T < LO: return          # too far: C stays as it is
#         C = T; COUNT = COUNT + 1
# Used twice: to walk a candidate up to a range (COUNT is ignored), and to produce decimal digits.
@ STEP_UP
	lia 0; putA COUNT                                                                    # COUNT = 0
@ STEP_UP_AGAIN
	# T = C + S      (three words, lowest first; the carry travels in rgAH)
	getA C_0; getB S_0; sum; putA T_0                                                    # word 0: A = C_0 + S_0
	carryB; getA C_1; sum; getB S_1; sum; putA T_1                                                   # word 1: A = carry + C_1 + S_1
	carryB; getA C_2; sum; getB S_2; sum; putA T_2                                                   # word 2: A = carry + C_2 + S_2
	# compare T with LO, highest word first; afterwards: nega if T < LO, zero if equal
	getA T_2; getB LO_2; if_neq CMP_5                                                    # word 2 differs: it decides
	getA T_1; getB LO_1; if_neq CMP_5                                                    # word 1 differs: it decides
	getA T_0; getB LO_0                                                                  # otherwise word 0 decides
@ CMP_5
	sub                                                                                  # A - B sets the flags zero and nega
	if_nega STEP_UP_TAKE                                                                 # T < LO: take the step
	ret                                                                                  # otherwise done
@ STEP_UP_TAKE
	# C = T, word by word
	getA T_0; putA C_0; getA T_1; putA C_1; getA T_2; putA C_2
	inc COUNT                                                                            # COUNT = COUNT + 1
	goto STEP_UP_AGAIN

# COPY_3: copy three words (one number) from the address in SRC to the address in DST; both move on by three.
#     repeat 3 times: memory[DST] = memory[SRC]; SRC = SRC + 1; DST = DST + 1
@ COPY_3
	do COPY_1
	do COPY_1
	do COPY_1
	ret

# COPY_1: copy one word from the address in SRC to the address in DST; both move on by one.
#     memory[DST] = memory[SRC]; SRC = SRC + 1; DST = DST + 1
# SRC and DST are pointers: variables that hold an address. Reading through one takes two loads:
# first the address into B, then the word at that address.
@ COPY_1
	getB SRC; load rgA rgB; putAat DST                                                   # A = memory[SRC]; memory[DST] = A
	inc SRC                                                                              # SRC = SRC + 1
	inc DST                                                                              # DST = DST + 1
	ret

# ---- The table of half lengths k = 1..5 ----
# One entry per k:
#     1 word    the address of the next entry (0 in the last, empty entry)
#     3 words   the smallest candidate, 10^(k-1) * (10^k + 1)        e.g. k = 2: 10 * 101 = 1010
#     3 words   the largest candidate, 10^(2k) - 1                   e.g. k = 2: 9999
#     3 words each: the steps (10^k + 1) * 10^j for j = k-1 down to 0     e.g. k = 2: 1010, 101
# A number is written low word first: 1000010000 = 0x3B9A_F110 is  0xF110; 0x3B9A; 0x0000.
origin 0x3000
# k = 1: candidates 11 to 99, step 11
0x300A                        # the next entry
0x000B; 0x0000; 0x0000        # smallest 11
0x0063; 0x0000; 0x0000        # largest 99
0x000B; 0x0000; 0x0000        # step 11
# k = 2: candidates 1010 to 9999, step 101
0x3017                        # the next entry
0x03F2; 0x0000; 0x0000        # smallest 1010
0x270F; 0x0000; 0x0000        # largest 9999
0x03F2; 0x0000; 0x0000        # step 1010
0x0065; 0x0000; 0x0000        # step 101
# k = 3: candidates 100100 to 999999, step 1001
0x3027                        # the next entry
0x8704; 0x0001; 0x0000        # smallest 100100
0x423F; 0x000F; 0x0000        # largest 999999
0x8704; 0x0001; 0x0000        # step 100100
0x271A; 0x0000; 0x0000        # step 10010
0x03E9; 0x0000; 0x0000        # step 1001
# k = 4: candidates 10001000 to 99999999, step 10001
0x303A                        # the next entry
0x9A68; 0x0098; 0x0000        # smallest 10001000
0xE0FF; 0x05F5; 0x0000        # largest 99999999
0x9A68; 0x0098; 0x0000        # step 10001000
0x42A4; 0x000F; 0x0000        # step 1000100
0x86AA; 0x0001; 0x0000        # step 100010
0x2711; 0x0000; 0x0000        # step 10001
# k = 5: candidates 1000010000 to 9999999999, step 100001
0x3050                        # the next entry
0xF110; 0x3B9A; 0x0000        # smallest 1000010000
0xE3FF; 0x540B; 0x0002        # largest 9999999999
0xF110; 0x3B9A; 0x0000        # step 1000010000
0xE4E8; 0x05F5; 0x0000        # step 100001000
0x96E4; 0x0098; 0x0000        # step 10000100
0x424A; 0x000F; 0x0000        # step 1000010
0x86A1; 0x0001; 0x0000        # step 100001
0; 0; 0; 0; 0; 0; 0

# ---- Powers of ten, 10^14 down to 1, then 0 ----
origin 0x3100
0x4000; 0x107A; 0x5AF3        # 10^14
0xA000; 0x4E72; 0x0918        # 10^13
0x1000; 0xD4A5; 0x00E8        # 10^12
0xE800; 0x4876; 0x0017        # 10^11
0xE400; 0x540B; 0x0002        # 10^10
0xCA00; 0x3B9A; 0x0000        # 10^9
0xE100; 0x05F5; 0x0000        # 10^8
0x9680; 0x0098; 0x0000        # 10^7
0x4240; 0x000F; 0x0000        # 10^6
0x86A0; 0x0001; 0x0000        # 10^5
0x2710; 0x0000; 0x0000        # 10^4
0x03E8; 0x0000; 0x0000        # 10^3
0x0064; 0x0000; 0x0000        # 10^2
0x000A; 0x0000; 0x0000        # 10^1
0x0001; 0x0000; 0x0000        # 10^0
0; 0; 0

# ---- The input: 11 ranges ----
# Per range: the first ID, then the last ID, each as three words, low word first.
origin 0x2000
# 11-22
0x000B; 0x0000; 0x0000
0x0016; 0x0000; 0x0000
# 95-115
0x005F; 0x0000; 0x0000
0x0073; 0x0000; 0x0000
# 998-1012
0x03E6; 0x0000; 0x0000
0x03F4; 0x0000; 0x0000
# 1188511880-1188511890
0x4088; 0x46D7; 0x0000
0x4092; 0x46D7; 0x0000
# 222220-222224
0x640C; 0x0003; 0x0000
0x6410; 0x0003; 0x0000
# 1698522-1698528
0xEADA; 0x0019; 0x0000
