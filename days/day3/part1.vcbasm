# Advent of Code 2025, day 3 part 1 (Lobby)
#
# THE PUZZLE
# Each line of the input is a bank of batteries, each battery a digit 1-9. From every bank exactly two
# batteries are switched on; the bank's joltage is the two-digit number they form, in their order in the
# bank. The answer is the sum of the largest joltage of every bank.
#
# THE IDEA
# Go through a bank once, digit by digit, and remember three things:
#     MAX    the largest digit seen so far
#     TENS, UNITS   the best pair found so far
# When a new digit D arrives, the best pair that ends in D has MAX as its first digit (the largest digit
# before D). So the new candidate is the pair (MAX, D). It replaces (TENS, UNITS) when it is larger.
# Because MAX never gets smaller, TENS is an older value of MAX and MAX >= TENS always holds. That makes
# the comparison short:
#     MAX != TENS   means MAX > TENS:        the candidate wins, whatever D is
#     MAX == TENS   the first digits tie:    the candidate wins when D > UNITS
# Example 818181911112111: after 8,1,8,1,8,1 the best pair is 88. Then 9 arrives: candidate 89 wins
# (same tens, larger units), and MAX becomes 9. Then 1: candidate 91 wins, because 9 != 8. The 2 later
# gives 92, the answer for this bank.
#
# NO MULTIPLICATION
# A bank's joltage is 10 * TENS + UNITS, and the CPU cannot multiply. So the program adds up all TENS in
# SUM_TENS and all UNITS in SUM and multiplies once at the end, by doubling:
#     10 * x = 8 * x + 2 * x = ((x + x) + (x + x)) + ((x + x) + (x + x)) + (x + x)
#
# THE WHOLE PROGRAM IN PSEUDO CODE
#     SUM = 0; SUM_TENS = 0
#     MAX = 0; TENS = 0; UNITS = 0
#     loop:
#         D = input[IN]; IN = IN + 1
#         if D == 0:                            # the end of a bank
#             if MAX == 0: break                # an empty bank: the end of the input
#             SUM_TENS = SUM_TENS + TENS
#             SUM = SUM + UNITS
#             MAX = 0; TENS = 0; UNITS = 0
#             continue
#         if MAX != TENS: TENS = MAX; UNITS = D # the pair (MAX, D) beats (TENS, UNITS)
#         else if D > UNITS: UNITS = D
#         if D > MAX: MAX = D
#     SUM = SUM + 10 * SUM_TENS
#     write SUM as five decimal digits
#     stop
#
# The first digit of a bank is compared against MAX = 0, which gives the pair (0, D). Every later pair
# has a first digit of at least 1, so it replaces that one; a bank has at least two digits.
#
# THE RESULT, when the CPU stops on the Breakpoint at END
#   0x0100         the sum as one 16-bit word
#   0x0110-0x0114  the sum as five decimal digits, one per word, most significant first
#
# THE INPUT (rule 1 of RULES.md), at 0x2000
# One word per battery holding its digit, bank after bank; a word 0 ends each bank, and a second 0 after
# the last bank ends the input. Built-in limits: the sum must stay below 65,536, which holds for up to
# 661 banks (a bank gives at most 99).
#
# ONE WORD IS ENOUGH
# Every value here fits in 16 bits, so each variable is one memory word, and the 32-bit registers never
# carry. The two idioms used everywhere (v is a variable's address, below 0x1000):
#     getA v                   A = the word at v   (lia v; load rgA rgA: lia puts the address in A, load replaces it)
#     getB v                   B = the word at v
#     putA v                   the word at v = A   (this uses up B)
# and the two comparisons:
#     if_eq L / if_neq L       compares A with B as they are now
#     sub; if_nega L           after A - B: taken when A < B
# What each instruction does exactly is in findings/cpu-instructions.md.
#
# MEMORY MAP
#   0x0100-0x0128  variables            0x2000-  the input
#   0x1000-        the program          0x1F00-  POWERS: 10000, 1000, 100, 10, 1, 0
#   (the input is long: 200 banks of 100 digits end at 0x6EE8, so nothing else may lie above 0x2000)
#   0xFF00         where the CPU starts

# ---- The CPU's instructions as symbols (day 1's table without its _32 names, which the CPU ignores) ----
symbol nop 0b0000_0000_0000_0000            # the word 0: stops the CPU (the same word as non)
symbol ld  0b0010_0000_0000_0000            # load a register from memory (used through the load macro)
symbol lia 0b0011_0000_0000_0000            # lia n: A = n (0 to 4095), upper half 0
symbol lib 0b0100_0000_0000_0000            # lib n: B = n (0 to 4095), upper half 0
symbol sto 0b0101_0000_0000_0000            # store a register to memory (used through the store macro)

macro  load  { ld  | a? | (b? >> 6) }       # load X Y: X = the word at the address in Y
macro  store { sto | a? | (b? >> 6) }       # store X Y: the word at the address in Y = X

symbol sum    0b0110_0100_0000_0000         # A = A + B (32 bits), sets zero, carry, nega
symbol sub    0b0110_0010_0000_0000         # A = A - B (32 bits), sets zero, carry, nega
symbol shf    0b0110_0001_0000_0000         # shf | k: A = A shifted left by k (0 to 15)
symbol and    0b0110_0000_1000_0000         # A = A and B
symbol or     0b0110_0000_0100_0000         # A = A or B
symbol xor    0b0110_0000_0010_0000         # A = A xor B
symbol neg    0b0110_0000_0001_0000         # A = every bit of A flipped

symbol psh 0b1010_0000_0000_0000            # psh X: push the 16 bits of X
symbol pop 0b1011_0000_0000_0000            # pop X: pop 16 bits into X

symbol jmp  0b1100_0000_0000_0000           # jmp; L: go to L.  jmp c; L: go to L when c holds
symbol call 0b1110_0000_0000_0000           # call; L: run the subroutine at L
symbol ret  0b1111_0000_0000_0000           # return from a subroutine

# The registers, as load, store, psh and pop name them
symbol rgAH 0b1000_0000_0000                # the upper 16 bits of A
symbol rgA  0b0100_0000_0000                # the lower 16 bits of A
symbol rgBH 0b0010_0000_0000                # the upper 16 bits of B
symbol rgB  0b0001_0000_0000                # the lower 16 bits of B
symbol rgSP 0b0000_1000_0000                # the program counter (leave alone)
symbol rgSB 0b0000_0100_0000                # the stack pointer (leave alone)
symbol non  0                               # stops the CPU (Breakpoint): the end of the program

# The conditions of jmp
symbol zero  0b1000_0000_0000               # the last sum or sub gave 0
symbol carry 0b0100_0000_0000               # the last sum carried, or the last sub did not borrow (A >= B)
symbol nega  0b0010_0000_0000               # the last sub went below 0 (A < B)
symbol eq    0b0001_0000_0000               # A == B right now
symbol neq   0b0000_1000_0000               # A != B right now

# ---- Macros for the common operations (explained in the README). A macro cannot use another macro, so
#      load and store are spelled out here. v: a variable, p: a variable holding an address, L: a label ----
macro getA     { lia a?; ld | rgA | (rgA >> 6) }                                              # A = v
macro getB     { lib a?; ld | rgB | (rgB >> 6) }                                              # B = v
macro putA     { lib a?; sto | rgA | (rgB >> 6) }                                             # v = A (uses B)
macro putAat   { lib a?; ld | rgB | (rgB >> 6); sto | rgA | (rgB >> 6) }                      # the word p points at = A (uses B)
macro inc      { lia a?; ld | rgA | (rgA >> 6); lib 1; sum; lib a?; sto | rgA | (rgB >> 6) }  # v = v + 1 (uses A and B)
macro copyAB   { psh rgA; pop rgB }                                                           # B = A (lower half)
macro goto     { jmp; a? }                                                                    # go to L
macro if_eq    { jmp eq; a? }                                                                 # go to L when A == B
macro if_neq   { jmp neq; a? }                                                                # go to L when A != B
macro if_carry { jmp carry; a? }                                                              # go to L after a sub when A >= B
macro if_nega  { jmp nega; a? }                                                               # go to L after a sub when A < B

# ---- Variables (all below 0x1000, so lia/lib can address them) ----
# The result
pointer SUM 0x0100 0
# The sum of the tens digits of all banks, multiplied by 10 at the end
pointer SUM_TENS 0x0101 0
# The current bank: the digit just read, the largest digit so far, and the best pair so far
pointer D 0x0120 0
pointer MAX 0x0121 0
pointer TENS 0x0122 0
pointer UNITS 0x0123 0
# For the decimal digits: the current power of ten and how often it fitted
pointer POWER 0x0124 0
pointer COUNT 0x0125 0
# Pointers: IN the next input word, DIGIT the next digit to write, POW the next power of ten
pointer IN 0x0126 0x2000
pointer DIGIT 0x0127 0x0110
pointer POW 0x0128 0x1F00

# ---- The CPU starts at 0xFF00 ----
origin 0xFF00
goto MAIN

origin 0x1000
@ MAIN
# ==== read the next digit ====
#     D = input[IN]; IN = IN + 1
#     if D == 0: goto END_OF_BANK
# IN is a pointer: a variable that holds an address. Reading through it takes two loads: first the
# address into B, then the word at that address into A. lia 0 first clears A's upper half, because
# load only replaces the lower half.
@ NEXT_DIGIT
	lia 0; getB IN; load rgA rgB                                 # A = input[IN]
	putA D                                                       # D = A
	lib 0                                                        # B = 0, to compare with
	if_eq END_OF_BANK                                            # D == 0: the bank is finished
	inc IN                                                       # IN = IN + 1

# ==== is the pair (MAX, D) better than (TENS, UNITS)? ====
#     if MAX != TENS: TENS = MAX; UNITS = D      # MAX > TENS: a larger first digit wins
#     else if D > UNITS: UNITS = D               # the same first digit: the larger second digit wins
	getA MAX; getB TENS                                          # A = MAX, B = TENS
	if_neq NEW_PAIR                                              # MAX != TENS, so MAX > TENS
	# MAX == TENS: compare the second digits
	getA UNITS; getB D                                           # A = UNITS, B = D
	sub                                                          # A - B is negative when UNITS < D
	if_nega NEW_UNITS                                            # D > UNITS
	goto UPDATE_MAX                                              # the old pair stays
@ NEW_PAIR
	getA MAX; putA TENS                                          # TENS = MAX
@ NEW_UNITS
	getA D; putA UNITS                                           # UNITS = D

# ==== remember the largest digit ====
#     if D > MAX: MAX = D
# This comes after the pair test, so that D is never paired with itself.
@ UPDATE_MAX
	getA MAX; getB D                                             # A = MAX, B = D
	sub                                                          # A - B is negative when MAX < D
	if_nega NEW_MAX                                              # D > MAX
	goto NEXT_DIGIT                                              #
@ NEW_MAX
	getA D; putA MAX                                             # MAX = D
	goto NEXT_DIGIT                                              #

# ==== the end of a bank ====
#     if MAX == 0: goto ALL_BANKS_DONE           # no digit was read: this 0 ends the input
#     SUM_TENS = SUM_TENS + TENS
#     SUM = SUM + UNITS
#     MAX = 0; TENS = 0; UNITS = 0
#     IN = IN + 1                                # step over the 0
@ END_OF_BANK
	getA MAX; lib 0                                              # A = MAX, B = 0
	if_eq ALL_BANKS_DONE                                         # an empty bank: the input is finished
	getA SUM_TENS; getB TENS; sum                                # A = SUM_TENS + TENS
	putA SUM_TENS                                                # SUM_TENS = A
	getA SUM; getB UNITS; sum                                    # A = SUM + UNITS
	putA SUM                                                     # SUM = A
	lia 0; putA MAX; putA TENS                                   # MAX = 0; TENS = 0
	putA UNITS                                                   # UNITS = 0
	inc IN                                                       # IN = IN + 1
	goto NEXT_DIGIT                                              #

# ==== SUM = SUM + 10 * SUM_TENS ====
# Doubling is A + A. copyAB (psh rgA; pop rgB) copies A into B (B's upper half is 0 after the lib before it).
#     A = SUM_TENS
#     A = A + A                                  # 2 * SUM_TENS
#     SUM = SUM + A
#     A = A + A; A = A + A                       # 8 * SUM_TENS
#     SUM = SUM + A
@ ALL_BANKS_DONE
	getA SUM_TENS; lib 0                                         # A = SUM_TENS; B = 0 clears B's upper half
	copyAB; sum                                                  # A = 2 * SUM_TENS
	putA SUM_TENS                                                # SUM_TENS = 2 * SUM_TENS (kept for the next step)
	getB SUM; sum; putA SUM                                      # SUM = SUM + 2 * SUM_TENS
	getA SUM_TENS; lib 0                                         # A = 2 * SUM_TENS
	copyAB; sum                                                  # A = 4 * SUM_TENS
	copyAB; sum                                                  # A = 8 * SUM_TENS
	getB SUM; sum; putA SUM                                      # SUM = SUM + 8 * SUM_TENS

# ==== write SUM as five decimal digits ====
# A digit is how often a power of ten fits into what is left. Without division that is counting:
#     D = SUM                                    # D is free now; it holds what is left
#     for POWER in 10000, 1000, 100, 10, 1:
#         COUNT = 0
#         while D >= POWER: D = D - POWER; COUNT = COUNT + 1
#         memory[DIGIT] = COUNT; DIGIT = DIGIT + 1
# After sub, the carry flag is set when A >= B (no borrow).
	getA SUM; putA D                                             # D = SUM
@ NEXT_POWER
	lia 0; getB POW; load rgA rgB                                # A = powers[POW]
	putA POWER                                                   # POWER = A
	lib 0                                                        # B = 0
	if_eq END                                                    # a power of 0 ends the table
	inc POW                                                      # POW = POW + 1
	lia 0; putA COUNT                                            # COUNT = 0
@ COUNT_AGAIN
	getA D; getB POWER                                           # A = D, B = POWER
	sub                                                          # A = D - POWER
	if_carry COUNT_ONE                                           # D >= POWER: it fits once more
	getA COUNT; putAat DIGIT                                       # memory[DIGIT] = COUNT   (B holds the address in DIGIT)
	inc DIGIT                                                    # DIGIT = DIGIT + 1
	goto NEXT_POWER                                              #
@ COUNT_ONE
	putA D                                                       # D = D - POWER   (A still holds the difference)
	inc COUNT                                                    # COUNT = COUNT + 1
	goto COUNT_AGAIN                                             #

# The word 0 stops the CPU on its Breakpoint.
@ END
	non

# ---- Powers of ten for the decimal digits, then 0 ----
origin 0x1F00
10000; 1000; 100; 10; 1; 0

# ---- The input: 200 banks ----
# One word per battery; a 0 ends each bank; one more 0 ends the input.
origin 0x2000
