# ---- The gaps of the sort, then 0 ----
origin 0x1E80
364; 121; 40; 13; 4; 1; 0

# ---- The neighbours of a cell: what to add to CORNER for each, then 0xFFFF ----
origin 0x1E90
0; 1; 2; 32; 33; 34; 64; 65; 66; 0xFFFF

# ---- The row of shifts of SHIFT_LEFT: entered NSHIFT words before its end ----
origin 0x1F00
	shf | 1; shf | 1; shf | 1; shf | 1
	shf | 1; shf | 1; shf | 1; shf | 1
	shf | 1; shf | 1; shf | 1; shf | 1
	shf | 1; shf | 1; shf | 1; shf | 1
	ret

