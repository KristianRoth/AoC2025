0x0000; 0x0080    # 2^23
0x0000; 0x0040    # 2^22
0x0000; 0x0020    # 2^21
0x0000; 0x0010    # 2^20
0x0000; 0x0008    # 2^19
0x0000; 0x0004    # 2^18
0x0000; 0x0002    # 2^17
0x0000; 0x0001    # 2^16
0x8000; 0x0000    # 2^15
0x4000; 0x0000    # 2^14
0x2000; 0x0000    # 2^13
0x1000; 0x0000    # 2^12
0x0800; 0x0000    # 2^11
0x0400; 0x0000    # 2^10
0x0200; 0x0000    # 2^9
