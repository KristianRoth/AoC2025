13479; 12152; 14926; 17402; 6211; 3133; 15586; 13936; 1476; 8290; 13971; 4611; 5523; 17427; 0xFFFF    # tyl: rzk wcc zti jex eqn xbm uqa ceu mgw urj gvj iel zuh
7732; 217; 0xFFFF    # llk: aij
